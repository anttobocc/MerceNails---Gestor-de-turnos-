# Puerto del servidor
PORT=3000

# Contraseña inicial del panel (solo se usa la primera vez que arranca, si todavía no hay contraseña guardada)
ADMIN_PASSWORD=cambiar-esta-clave

# Carpeta donde se guarda la base de datos (por defecto ./data)
# DATA_DIR=./data

# En producción (HTTPS) poné NODE_ENV=production para que la cookie de sesión sea segura
# NODE_ENV=production
